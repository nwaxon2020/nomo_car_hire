rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isCEO() {
      return request.auth != null && request.auth.uid == "oto7WgugASOkcA4oBl6OB6C39Ww1";
    }

    function hasPermission(route) {
      let staffDoc = get(/databases/$(database)/documents/adminStaffs/$(request.auth.uid)).data;
      return isCEO() || (staffDoc != null && route in staffDoc.allowedRoutes);
    }

    function isAnyAdmin() {
      return isCEO() || exists(/databases/$(database)/documents/adminStaffs/$(request.auth.uid));
    }

    // --- COLLECTION MATCHES ---

    // 1. USERS
    match /users/{userId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        isCEO() || 
        (hasPermission("/admin/manage-driver") && (
          resource.data.verified == false || request.resource.data.verified == true || isCEO()
        ))
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // 2. BOOKING REQUESTS
    match /bookingRequests/{requestId} {
      allow read, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isCEO());
      allow create, update: if request.auth != null;
    }

    // 3. TRIPS 
    match /trips/{tripId} {
      allow read: if request.auth != null && (
        resource.data.customerId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        isCEO()
      );
      allow create, update: if request.auth != null;
      // FIX: Allow users to delete their own trips
      allow delete: if request.auth != null && (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid || isCEO());
    }
    
    // 4. ADMIN STAFF & ROUTE CONFIG
    match /adminStaffs/{staffId} {
      allow read: if request.auth != null; 
      allow write: if isCEO();
    }

    match /adminRoutes/{docId} {
      allow read: if isAnyAdmin();
      allow write: if isCEO();
    }

    // ============================================
    // FIXED: NEW ADMIN FINANCE & CONFIG RULES! 
    match /adminfinance/{docId} {
      allow read: if true; 
      allow write: if isCEO() || hasPermission("/admin/finance"); 
    }
    match /adminConfig/{docId} {
      allow read: if true; 
      allow write: if isCEO(); 
    }
    // ============================================

    // 5. COMPLAINS
    match /complains/{complaintId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (resource.data.userId == request.auth.uid || hasPermission("/admin/complaints"));
      allow delete: if hasPermission("/admin/complaints") || isCEO();
    }

    // 6. VEHICLES & LOGS
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if hasPermission("/admin/manage-driver");
    }
    
    match /vehicleLog/{logId} {
      allow read: if true;
      allow update: if isCEO() || hasPermission("/admin/manage-driver") || hasPermission("/admin/applicants");
      allow create: if request.auth != null;
      // FIX: Allow users to delete their own vehicle logs
      allow delete: if request.auth != null && (resource.data.driverId == request.auth.uid || isCEO());
    }

    // Legacy support
    match /bookings/{bookingId} {
      allow read, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isCEO());
      allow create, update: if request.auth != null;
    }

    // 7. CHATS
    match /preChats/{chatId} {
      allow read, create: if request.auth != null;
      allow delete: if request.auth != null && (request.auth.uid in resource.data.participants || isCEO());
    }

    // 8. CMS & SITE CONTENT
    match /cms/{docId} { allow read: if true; allow write: if hasPermission("/admin/content-manager") || isCEO(); }
    match /siteContent/{docId} { allow read: if true; allow write: if hasPermission("/admin/content-manager") || isCEO(); }
    match /site_configs/{docId} { allow read: if true; allow write: if isCEO(); }
    match /generalSiteReviews/{reviewId} { allow read: if true; allow write: if request.auth != null; }

    // 9. FAQ & POLICIES
    match /faq_categories/{catId} { allow read: if true; allow write: if isCEO() || hasPermission("/admin/faq-editor"); }
    match /faq_questions/{qId} { allow read: if true; allow write: if isCEO() || hasPermission("/admin/faq-editor"); }
    match /site_policies/{policyId} { allow read: if true; allow write: if isCEO() || hasPermission("/admin/policy-editor"); }

    // 10. SETTINGS
    match /settings/{docId} {
      allow read: if true; 
      allow write: if isCEO();
    }
    
    // GLOBAL SAFETY
    match /{document=**} {
      allow read, write: if isCEO();
    }
  }
}
