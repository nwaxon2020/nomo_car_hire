rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isCEO() {
      return request.auth != null && request.auth.uid == "oto7WgugASOkcA4oBl6OB6C39Ww1";
    }

    function hasPermission(route) {
      return request.auth != null && (
        isCEO() || 
        (get(/databases/$(database)/documents/adminStaffs/$(request.auth.uid)).data != null && 
         route in get(/databases/$(database)/documents/adminStaffs/$(request.auth.uid)).data.allowedRoutes)
      );
    }

    function isAnyAdmin() {
      return isCEO() || exists(/databases/$(database)/documents/adminStaffs/$(request.auth.uid));
    }

    function isDriver() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isDriver == true;
    }

    function isNotDisabled() {
      // Admins are never considered "disabled" by this rule logic
      return request.auth == null || isAnyAdmin() || 
             (!exists(/databases/$(database)/documents/users/$(request.auth.uid))) ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("isDisabled", false) == false;
    }

    function isValidReviewUpdate() {
      let allowedFields = ['comments', 'ratings', 'averageRating', 'totalRatings', 'updatedAt', 'userRatings'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    function isValidProfileUpdate() {
      let allowedFields = [
        'location', 'isLocationActive', 'locationLastUpdated', 'locationSharedAt',
        'lastLocationUpdate', 'searchableLocations',
        'emergencyContact', 'lovedOnes', 'whatsappLovedOnes',
        'firstName', 'lastName', 'fullName', 'phoneNumber', 'city', 'state', 
        'whatsappPreferred', 'profileImage', 'fcmToken', 'updatedAt', 
        'lastActive', 'notificationEnabled', 'notifications', 'hasUnreadNotifications',
        'unreadChats', 'preferences', 'email', 'authType', 'isEmailVerified',
        'rating', 'totalTrips', 'earnings', 'isDriver', 'vip', 'bidsUsed', 'lastBidReset',
        'vehicleLog', 'bookingVehicleId', 'bookingVehicleLastUpdated', 'bookingVehicleDate', 'verified',
        'hasCompany', 'ownedCompanies',
        'customersCarried', 'customersCarriedMonth',
        'trustScore', 'trustCancels', 'trustLastReset', 'trustExhaustedAt', 
        'driverTrustScore', 'driverTrustCancels', 'driverTrustExhaustedAt', 'driverLoadBlockedUntil',
        'loadOnceAllowed', 'loadOnceUsedDate', 'loadBlockedUntil',
        'contactedDrivers', 'hiredCars', 'lastBookedCarId', 'carSwitchCount', 'tripHistory'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    function isReferralRewardUpdate() {
      let allowedFields = [
        'referralPoints', 'referrals', 'referralCount', 'freeRides', 'freeRidesUsed',
        'lastFreeRideEarned', 'notifications', 'hasUnreadNotifications'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Public read: needed for Bookings page, home page driver counts, driver profiles
      allow read: if true;
      // Create: only the owner can create their own account document
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && isNotDisabled() && (
        // 1. Own profile fields (includes searchableLocations, customersCarried etc.)
        (request.auth.uid == userId && isValidProfileUpdate()) ||

        // 2. Anyone authenticated can sync unread chat badge to another user
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadChats'])) ||

        // 3. Any authenticated user can push a notification or booking alert to a driver
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifications', 'hasUnreadNotifications'])) ||

        // 4. Drivers can update passenger count / monthly tracking on their own profile
        (request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customersCarried', 'customersCarriedMonth'])) ||

        // 5. Review logic: any authenticated user can rate a driver
        (request.auth.uid != userId && 
         get(/databases/$(database)/documents/users/$(userId)).data.isDriver == true &&
         isValidReviewUpdate()) ||

        // 6. Referral reward updates (admin or automated)
        (isAnyAdmin() && (
          isReferralRewardUpdate() || 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fareReceived', 'fareReceivedAt', 'referralPoints'])
        )) ||

        // 7. Driver Managers can verify/unverify accounts
        (hasPermission('/admin/manage-driver') && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified'])) ||

        // 8. CEO has full autonomy
        isCEO()
      );
      allow delete: if isCEO();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // BOOKING REQUESTS (Car Hire page)
    // ─────────────────────────────────────────────────────────────────────────
    match /bookingRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isNotDisabled();
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isCEO());
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        (isDriver() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offers', 'views', 'rejectedOnce', 'rejectedTwice'])) ||
        isCEO()
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // DIRECT OFFERS (Live booking flow)
    // ─────────────────────────────────────────────────────────────────────────
    match /directOffers/{offerId} {
      // Any authenticated user can read (needed for GlobalDriverListener & waiting page)
      allow read: if request.auth != null;
      allow create: if request.auth != null && isNotDisabled();
      // Driver or customer can update the offer
      allow update: if request.auth != null && isNotDisabled() && (
        resource.data.driverId == request.auth.uid || 
        resource.data.customerId == request.auth.uid || 
        isCEO()
      );
      allow delete: if request.auth != null && (
        resource.data.driverId == request.auth.uid || 
        resource.data.customerId == request.auth.uid || 
        isCEO()
      );
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // LOAD BOOKINGS (Shared Transit)
    // ─────────────────────────────────────────────────────────────────────────
    
    // Collection Group Match for Seats (needed for cross-service banners)
    match /{path=**}/seats/{seatId} {
      allow read: if request.auth != null;
    }

    match /loadBookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isNotDisabled() && isDriver();
      allow delete: if request.auth != null && (resource.data.driverId == request.auth.uid || isCEO());
      allow update: if request.auth != null && (
        resource.data.driverId == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedCount', 'updatedAt']) ||
        isCEO()
      );

      match /seats/{seatId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/loadBookings/$(bookingId)).data.driverId == request.auth.uid ||
          (request.resource.data.status == 'booked' && resource.data.status == 'available') ||
          (resource.data.customerId == request.auth.uid) ||
          isCEO()
        );
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // TRIPS
    // ─────────────────────────────────────────────────────────────────────────
    match /trips/{tripId} {
      // Any authenticated user can read trips (needed for profile history, driver pages)
      allow read: if request.auth != null;
      allow create: if request.auth != null && isNotDisabled();
      allow update: if request.auth != null && isNotDisabled() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        isCEO()
      );
      allow delete: if isAnyAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // VEHICLE LOG
    // ─────────────────────────────────────────────────────────────────────────
    match /vehicleLog/{logId} {
      // Public read: needed for Bookings page, home page, driver profile
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        isAnyAdmin() || 
        resource.data.driverId == request.auth.uid
      );
      allow delete: if isCEO() || (request.auth != null && resource.data.driverId == request.auth.uid);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PRE-CHATS
    // ─────────────────────────────────────────────────────────────────────────
    match /preChats/{chatId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        chatId.matches(".*" + request.auth.uid + ".*") ||
        (resource != null && request.auth.uid in resource.data.participants) ||
        isCEO()
      );

      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          chatId.matches(".*" + request.auth.uid + ".*") || 
          isCEO()
        );
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // TRANSPORT HUB
    // ─────────────────────────────────────────────────────────────────────────
    match /transportCompanies/{companyId} {
      allow read: if true; 
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isAnyAdmin() || resource.data.ownerId == request.auth.uid);
      allow delete: if isCEO();

      // Visitor sub-collection
      match /visitors/{visitorId} {
        allow read: if request.auth != null && (isAnyAdmin() || resource.data.userId == request.auth.uid);
        allow create, update: if request.auth != null;
        allow delete: if isCEO();
      }
    }

    match /transportListings/{listingId} {
      function getCompanyData(companyId) {
        return get(/databases/$(database)/documents/transportCompanies/$(companyId)).data;
      }
      allow read: if true; 
      allow create: if request.auth != null && (
        isAnyAdmin() || 
        (getCompanyData(request.resource.data.companyId).ownerId == request.auth.uid &&
         getCompanyData(request.resource.data.companyId).expiryDate > request.time)
      );
      allow update: if request.auth != null && (
        isAnyAdmin() || 
        (getCompanyData(resource.data.companyId).ownerId == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        isAnyAdmin() || 
        (getCompanyData(resource.data.companyId).ownerId == request.auth.uid)
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // TRACKING TOKENS (public share link tracking)
    // ─────────────────────────────────────────────────────────────────────────
    match /trackingTokens/{tokenId} { 
      allow read: if true; 
      allow create: if request.auth != null; 
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isCEO()); 
    }

    // ─────────────────────────────────────────────────────────────────────────
    // WHATSAPP CONTACTS
    // ─────────────────────────────────────────────────────────────────────────
    match /whatsappContacts/{contactId} { 
      allow read: if request.auth != null; 
      allow write: if request.auth != null; 
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COMPLAINTS
    // ─────────────────────────────────────────────────────────────────────────
    match /complains/{complaintId} {
      allow create: if request.auth != null && isNotDisabled();
      allow read, update: if request.auth != null && (resource.data.userId == request.auth.uid || isAnyAdmin());
      allow delete: if isAnyAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PUBLIC / CONTENT COLLECTIONS
    // ─────────────────────────────────────────────────────────────────────────
    match /generalSiteReviews/{reviewId} { allow read: if true; allow write: if request.auth != null; }
    match /vehicles/{vehicleId}          { allow read: if true; allow write: if isAnyAdmin(); }
    match /site_policies/{policyId}      { allow read: if true; allow write: if isCEO() || hasPermission("/admin/policy-editor"); }
    match /faq_categories/{catId}        { allow read: if true; allow write: if isCEO() || hasPermission("/admin/faq-editor"); }
    match /faq_questions/{qId}           { allow read: if true; allow write: if isCEO() || hasPermission("/admin/faq-editor"); }
    match /cms/{docId}                   { allow read: if true; allow write: if hasPermission("/admin/content-manager") || isCEO(); }
    match /siteContent/{docId}           { allow read: if true; allow write: if hasPermission("/admin/content-manager") || isCEO(); }
    match /site_configs/{docId}          { allow read: if true; allow write: if isCEO(); }
    match /settings/{docId}             { allow read: if true; allow write: if isAnyAdmin(); }
    match /adminConfig/{docId}           { allow read: if true; allow write: if isCEO(); }
    match /adminfinance/pricing          { allow read: if request.auth != null; }
    match /adminfinance/{docId}          { allow read: if isCEO() || hasPermission("/admin/finance"); allow write: if isCEO() || hasPermission("/admin/finance"); }
    match /admin_metadata/{docId}        { allow read: if true; allow update: if request.auth != null; }

    // ─────────────────────────────────────────────────────────────────────────
    // ADMIN-ONLY COLLECTIONS
    // ─────────────────────────────────────────────────────────────────────────
    match /adminStaffs/{staffId}         { allow read: if request.auth != null && (request.auth.uid == staffId || isCEO()); allow write: if isCEO(); }
    match /adminRoutes/{docId}           { allow read: if isAnyAdmin(); allow write: if isCEO(); }
    match /adminSettings/{docId}         { allow read: if request.auth != null; allow write: if isAnyAdmin(); }
    match /employment_applications/{appId} { allow create: if true; allow read, write: if isAnyAdmin(); }

    // ─────────────────────────────────────────────────────────────────────────
    // CEO WILDCARD FALLBACK (catches any unmatched collection)
    // ─────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isCEO();
    }
  }
}